# PRODUCTION ENVIRONMENT CONFIGURATION
# Milestones Coffee Digital Menu Platform
# Phase 5: Security Hardening & Deployment

# ============ DATABASE ============
DATABASE_URL="postgresql://prod_user:CHANGE_IN_PRODUCTION@prod-db.internal:5432/milestones_coffee"
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_SSL=true

# ============ API SERVER ============
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=error
ENABLE_CORS=true
CORS_ORIGIN=https://admin.milestones.coffee,https://menus.milestones.coffee

# ============ JWT & AUTHENTICATION ============
JWT_SECRET=GENERATE_WITH_CRYPTO_20_BYTES_BASE64
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
SESSION_TIMEOUT_MINUTES=60

# ============ AWS CONFIGURATION ============
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_IN_PRODUCTION
AWS_SECRET_ACCESS_KEY=CHANGE_IN_PRODUCTION
AWS_S3_BUCKET=milestones-coffee-prod
AWS_S3_REGION=us-east-1
AWS_CLOUDFRONT_URL=https://images.milestones.coffee
AWS_S3_UPLOAD_EXPIRATION=3600

# ============ REDIS CACHING ============
REDIS_URL=redis://prod-redis.internal:6379
REDIS_PASSWORD=CHANGE_IN_PRODUCTION
REDIS_TIMEOUT_MS=5000
REDIS_RETRY_ATTEMPTS=3

# ============ RATE LIMITING & SECURITY ============
RATE_LIMIT=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BRUTE_FORCE_LOCKOUT=true
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_DURATION=900

# ============ TLS & CERTIFICATES ============
TLS_ENABLED=true
TLS_CERT_PATH=/etc/ssl/certs/milestones.crt
TLS_KEY_PATH=/etc/ssl/private/milestones.key
TLS_MIN_VERSION=TLSv1.2

# ============ MONITORING & OBSERVABILITY ============
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_URL=https://grafana.milestones.coffee
DATADOG_ENABLED=false
DATADOG_API_KEY=CHANGE_IN_PRODUCTION
SENTRY_ENABLED=true
SENTRY_DSN=CHANGE_IN_PRODUCTION

# ============ SECURITY HEADERS ============
HELMET_ENABLED=true
CSP_ENABLED=true
CSP_REPORT_URI=https://admin.milestones.coffee/csp-report
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# ============ AUDIT LOGGING ============
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_DATABASE=true
AUDIT_LOG_FILE=false

# ============ BACKUP & DISASTER RECOVERY ============
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true
BACKUP_S3_BUCKET=milestones-coffee-backups

# ============ FEATURE FLAGS ============
FEATURE_FLAG_SERVICE=true
FEATURE_FLAG_ANALYTICS=true
FEATURE_FLAG_ORDER_PLACEMENT=false
FEATURE_FLAG_LOYALTY_PROGRAM=false

# ============ DEPLOYMENT SPECIFIC ============
DEPLOYMENT_ENV=production
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_NAMESPACE=milestones-coffee
KUBERNETES_ENABLED=true
HEALTH_CHECK_INTERVAL=30
READINESS_PROBE_INITIAL_DELAY=10
READINESS_PROBE_PERIOD=10
