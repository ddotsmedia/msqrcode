FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache python3 make g++ && npm install -g pnpm@8

# Copy workspace manifests
COPY package.json pnpm-lock.yaml turbo.json tsconfig.json ./
COPY packages/api/package.json ./packages/api/package.json

# Install all dependencies including devDeps (needed for nest CLI, ts-node)
RUN pnpm install

WORKDIR /app/packages/api

EXPOSE 3001
EXPOSE 9090

CMD ["/app/node_modules/.bin/nest", "start", "--watch"]
