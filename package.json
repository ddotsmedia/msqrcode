{
  "name": "@milestones/root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "true",
    "test": "true",
    "lint": "true",
    "dev": "echo 'Use workspace packages'",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "rm -rf node_modules",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:check": "snyk test --severity-threshold=high"
  },
  "pnpm": {
    "workspaces": [
      "packages/*"
    ],
    "overrides": {
      "glob@<10.5.0": ">=10.5.0",
      "picomatch@<4.0.4": ">=4.0.4",
      "tmp@<0.2.6": ">=0.2.6",
      "postcss@<8.5.23": ">=8.5.23",
      "image-size@<2.0.3": ">=2.0.3",
      "ajv@<8.18.0": ">=8.18.0",
      "uuid@<11.1.1": ">=11.1.1",
      "decode-uri-component@<0.5.0": ">=0.5.0",
      "postcss-selector-parser@<7.1.6": ">=7.1.6",
      "webpack@<5.104.1": ">=5.104.1"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.11.7",
    "typescript": "^5.2.0"
  }
}
