{
  "expo": {
    "name": "Milestones",
    "slug": "milestones-coffee",
    "version": "1.0.0",
    "scheme": "milestones",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf6f0"
    },
    "ios": {
      "bundleIdentifier": "ae.coffeesales.app",
      "supportsTablet": false
    },
    "android": {
      "package": "ae.coffeesales.app",
      "minSdkVersion": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf6f0"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan table and branch QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
