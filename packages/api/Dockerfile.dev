FROM node:22-alpine

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++ && npm install -g pnpm@8

# Copy workspace configuration files
COPY package.json pnpm-lock.yaml turbo.json tsconfig.json ./

# Copy packages
COPY packages ./packages

# Install dependencies (this resolves workspace: protocol correctly with pnpm)
RUN pnpm install --frozen-lockfile

WORKDIR /app/packages/api

# Expose ports
EXPOSE 3000 9090

# Run NestJS in watch mode
CMD ["pnpm", "run", "dev"]
