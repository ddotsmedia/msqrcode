# Production Dockerfile with security hardening
# Stage 1: Builder
FROM node:18-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    && npm install -g pnpm@8

# Copy package files and workspace package.json files
COPY pnpm-lock.yaml package.json ./
COPY packages/database/package.json ./packages/database/
COPY packages/api/package.json ./packages/api/
COPY turbo.json tsconfig.json ./

# Install dependencies (pnpm needs to see workspace package.json before install)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/database ./packages/database
COPY packages/api ./packages/api

# Build application
RUN pnpm build --filter=@milestones/api

# Stage 2: Runtime (security-hardened)
FROM node:18-alpine

LABEL maintainer="Milestones Coffee <admin@milestones.coffee>"
LABEL description="Milestones Coffee Digital Menu Platform - API Server"
LABEL version="1.0.0"

# Create non-root user
RUN addgroup -g 2000 appuser && \
    adduser -D -u 2000 -G appuser appuser

WORKDIR /app

# Copy built application from builder
COPY --from=builder --chown=appuser:appuser /app/packages/api/dist ./dist
COPY --from=builder --chown=appuser:appuser /app/node_modules ./node_modules

# Copy environment template

# Create required directories
RUN mkdir -p /app/logs /app/tmp && \
    chown -R appuser:appuser /app

# Security: Remove unnecessary packages
RUN apk del --no-cache apk-tools && \
    rm -rf /var/cache/apk/* /tmp/*

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Expose port
EXPOSE 3000 9090

# Run application
CMD ["node", "dist/main.js"]
