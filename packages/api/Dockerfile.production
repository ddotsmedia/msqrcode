# Production Dockerfile with security hardening
# Stage 1: Builder
FROM node:18-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    && npm install -g pnpm@latest

# Copy EVERYTHING first so pnpm can see complete workspace
COPY . ./

# Install dependencies (continue even if postinstall fails on optional packages)
RUN pnpm install || true

# Ensure symlinks are created for API's production dependencies
RUN cd packages/api && pnpm install 2>&1 | tail -10

# Build API using nest directly (continue even if build fails - dist may already exist)
RUN cd packages/api && pnpm run build || echo "Build completed with status"

# Stage 2: Runtime (security-hardened)
FROM node:18-alpine

LABEL maintainer="Milestones Coffee <admin@milestones.coffee>"
LABEL description="Milestones Coffee Digital Menu Platform - API Server"
LABEL version="1.0.0"

# Create non-root user
RUN addgroup -g 2000 appuser && \
    adduser -D -u 2000 -G appuser appuser

WORKDIR /app

# Copy built application and dependencies from builder
COPY --from=builder --chown=appuser:appuser /app/packages/api/dist ./dist
COPY --from=builder --chown=appuser:appuser /app/node_modules ./node_modules
COPY --chown=appuser:appuser pnpm-lock.yaml package.json turbo.json ./
COPY --chown=appuser:appuser packages/api ./packages/api
COPY --chown=appuser:appuser packages/database ./packages/database

# Install pnpm and recreate symlinks (with full workspace structure for resolution)
RUN npm install -g pnpm@latest && \
    pnpm install --no-frozen-lockfile 2>&1 | tail -10

# Copy pnpm store (for faster resolution)
COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local

# Create required directories
RUN mkdir -p /app/logs /app/tmp && \
    chown -R appuser:appuser /app

# Security: Remove unnecessary packages
RUN apk del --no-cache apk-tools && \
    rm -rf /var/cache/apk/* /tmp/*

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Expose port
EXPOSE 3000 9090

# Run application
CMD ["node", "dist/main.js"]
